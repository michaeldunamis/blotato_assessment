{
  "name": "blotato-comments-takehome",
  "version": "1.0.0",
  "description": "Take-home: multi-platform social comment system (Fastify + Prisma)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test --no-file-parallelism",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^5.2.0",
    "@prisma/client": "^5.20.0",
    "@sinclair/typebox": "^0.32.35",
    "close-with-grace": "^2.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.20.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
